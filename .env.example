# Copie este arquivo para .env.local e ajuste conforme necessário.

# true  = modo demonstração (respostas simuladas, nenhuma chamada à API)
# false = usa o backend real em VITE_API_BASE_URL
VITE_DEMO_MODE=true

# URL base do backend. Deixe vazio para usar o mesmo domínio do frontend (/api/...).
# Exemplos: https://api.seudominio.com.br   |   http://localhost:3000
VITE_API_BASE_URL=

# Tempo máximo de espera pela resposta do backend, em milissegundos.
VITE_API_TIMEOUT_MS=30000

# Apenas desenvolvimento: redireciona /api do Vite para o backend (evita CORS).
VITE_DEV_PROXY_TARGET=http://localhost:3000

# Backend (server/dev-backend.mjs): lidas somente pelo Node, nunca vão ao bundle.
# Não use prefixo VITE_ nessas variáveis.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Opcional. Padrão: v23.0
WHATSAPP_API_VERSION=v23.0
